{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="card">
                    <div class="card-header">
                        <h2>Dashboard</h2>
                    </div>
                    <div class="card-body">
                        {% if is_admin %}
                            <div class="alert alert-success">
                                <h4 class="alert-heading">Welcome, {{ username }}!</h4>
                                <p>You are logged in as <strong>Admin</strong>. You have full access.</p>
                            </div>
                        {% else %}
                            <div class="alert alert-info">
                                <h4 class="alert-heading">Welcome, {{ username }}!</h4>
                                <p>You are logged in as <strong>Regular User</strong>. Limited access granted.</p>
                            </div>
                        {% endif %}
                        
                        <div class="mt-4">
                            <a href="{{ path('app_logout') }}" class="btn btn-danger">Logout</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
